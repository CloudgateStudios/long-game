DEFINE SCHEMA

    RECORD TYPE CD_AthleteProfile (
        CD_availabilityHours               BYTES QUERYABLE SORTABLE,
        CD_availabilityHours_ckAsset       ASSET,
        CD_biologicalSexRaw                ENCRYPTED STRING,
        CD_biologicalSexRaw_ckAsset        ASSET,
        CD_coachNotes                      ENCRYPTED STRING,
        CD_coachNotes_ckAsset              ASSET,
        CD_createdAt                       TIMESTAMP QUERYABLE SORTABLE,
        CD_dateOfBirth                     ENCRYPTED TIMESTAMP,
        CD_enabledSportsRaw                BYTES QUERYABLE SORTABLE,
        CD_enabledSportsRaw_ckAsset        ASSET,
        CD_entityName                      STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_ftpWatts                        ENCRYPTED DOUBLE,
        CD_heightCm                        ENCRYPTED DOUBLE,
        CD_maxHR                           ENCRYPTED DOUBLE,
        CD_moveReceipt                     BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset             ASSET,
        CD_restingHRBaseline               ENCRYPTED DOUBLE,
        CD_runTargetsRaw                   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_runTargetsRaw_ckAsset           ASSET,
        CD_thresholdRunPaceSecondsPerKm    ENCRYPTED DOUBLE,
        CD_thresholdSwimPaceSecondsPer100m ENCRYPTED DOUBLE,
        CD_weightKg                        ENCRYPTED DOUBLE,
        CD_zoneUpperBoundsOverride         ENCRYPTED BYTES,
        CD_zoneUpperBoundsOverride_ckAsset ASSET,
        "___createTime"                    TIMESTAMP,
        "___createdBy"                     REFERENCE,
        "___etag"                          STRING,
        "___modTime"                       TIMESTAMP,
        "___modifiedBy"                    REFERENCE,
        "___recordID"                      REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_CoachCharge (
        CD_cost                DOUBLE QUERYABLE SORTABLE,
        CD_date                TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_inputTokens         INT64 QUERYABLE SORTABLE,
        CD_kindRaw             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_kindRaw_ckAsset     ASSET,
        CD_model               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_model_ckAsset       ASSET,
        CD_moveReceipt         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset ASSET,
        CD_outputTokens        INT64 QUERYABLE SORTABLE,
        CD_sessionID           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_uuid                STRING QUERYABLE SEARCHABLE SORTABLE,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_CoachConversation (
        CD_createdAt                   TIMESTAMP QUERYABLE SORTABLE,
        CD_draftOutcomeReported        INT64 QUERYABLE SORTABLE,
        CD_draftPlanID                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_entityName                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_estimatedCost               DOUBLE QUERYABLE SORTABLE,
        CD_inputTokens                 INT64 QUERYABLE SORTABLE,
        CD_isTitleSettled              INT64 QUERYABLE SORTABLE,
        CD_kindRaw                     STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_kindRaw_ckAsset             ASSET,
        CD_messagesJSON                ENCRYPTED STRING,
        CD_messagesJSON_ckAsset        ASSET,
        CD_model                       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_model_ckAsset               ASSET,
        CD_moveReceipt                 BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset         ASSET,
        CD_outputTokens                INT64 QUERYABLE SORTABLE,
        CD_reportedDecisionIDs         BYTES QUERYABLE SORTABLE,
        CD_reportedDecisionIDs_ckAsset ASSET,
        CD_title                       ENCRYPTED STRING,
        CD_title_ckAsset               ASSET,
        CD_updatedAt                   TIMESTAMP QUERYABLE SORTABLE,
        CD_uuid                        STRING QUERYABLE SEARCHABLE SORTABLE,
        "___createTime"                TIMESTAMP,
        "___createdBy"                 REFERENCE,
        "___etag"                      STRING,
        "___modTime"                   TIMESTAMP,
        "___modifiedBy"                REFERENCE,
        "___recordID"                  REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_CoachReview (
        CD_assessment          ENCRYPTED STRING,
        CD_assessment_ckAsset  ASSET,
        CD_date                TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_flags               ENCRYPTED BYTES,
        CD_flags_ckAsset       ASSET,
        CD_inputTokens         INT64 QUERYABLE SORTABLE,
        CD_model               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_model_ckAsset       ASSET,
        CD_moveReceipt         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset ASSET,
        CD_outputTokens        INT64 QUERYABLE SORTABLE,
        CD_payloadJSON         ENCRYPTED STRING,
        CD_payloadJSON_ckAsset ASSET,
        CD_periodEnd           TIMESTAMP QUERYABLE SORTABLE,
        CD_periodStart         TIMESTAMP QUERYABLE SORTABLE,
        CD_title               ENCRYPTED STRING,
        CD_title_ckAsset       ASSET,
        CD_triggerRaw          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_triggerRaw_ckAsset  ASSET,
        CD_uuid                STRING QUERYABLE SEARCHABLE SORTABLE,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_CompletedWorkout (
        CD_activeEnergyKcal           ENCRYPTED DOUBLE,
        CD_activityName               ENCRYPTED STRING,
        CD_activityName_ckAsset       ASSET,
        CD_athleteNotes               ENCRYPTED STRING,
        CD_athleteNotes_ckAsset       ASSET,
        CD_averageCadence             ENCRYPTED DOUBLE,
        CD_averageHR                  ENCRYPTED DOUBLE,
        CD_averagePowerWatts          ENCRYPTED DOUBLE,
        CD_confidenceRaw              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_confidenceRaw_ckAsset      ASSET,
        CD_distanceMeters             ENCRYPTED DOUBLE,
        CD_durationSeconds            ENCRYPTED DOUBLE,
        CD_effortScore                ENCRYPTED DOUBLE,
        CD_entityName                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_externalID                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_feelRaw                    ENCRYPTED STRING,
        CD_feelRaw_ckAsset            ASSET,
        CD_heartRateHistogram         ENCRYPTED BYTES,
        CD_heartRateHistogram_ckAsset ASSET,
        CD_isMatchLocked              INT64 QUERYABLE SORTABLE,
        CD_isPrimary                  INT64 QUERYABLE SORTABLE,
        CD_isPrimaryManuallySet       INT64 QUERYABLE SORTABLE,
        CD_load                       ENCRYPTED DOUBLE,
        CD_maxHR                      ENCRYPTED DOUBLE,
        CD_moveReceipt                BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset        ASSET,
        CD_perceivedEffort            ENCRYPTED INT64,
        CD_plannedWorkout             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_sessionID                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_sourceName                 ENCRYPTED STRING,
        CD_sourceName_ckAsset         ASSET,
        CD_sourceRaw                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_sourceRaw_ckAsset          ASSET,
        CD_sportRaw                   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_sportRaw_ckAsset           ASSET,
        CD_start                      ENCRYPTED TIMESTAMP,
        CD_zoneSeconds                ENCRYPTED BYTES,
        CD_zoneSeconds_ckAsset        ASSET,
        "___createTime"               TIMESTAMP,
        "___createdBy"                REFERENCE,
        "___etag"                     STRING,
        "___modTime"                  TIMESTAMP,
        "___modifiedBy"               REFERENCE,
        "___recordID"                 REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_DailyMetrics (
        CD_activeEnergyKcal    ENCRYPTED DOUBLE,
        CD_bodyMassKg          ENCRYPTED DOUBLE,
        CD_date                TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_hrvSDNN             ENCRYPTED DOUBLE,
        CD_moveReceipt         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset ASSET,
        CD_respiratoryRate     ENCRYPTED DOUBLE,
        CD_restingHR           ENCRYPTED DOUBLE,
        CD_sleepAwakeSeconds   ENCRYPTED DOUBLE,
        CD_sleepCoreSeconds    ENCRYPTED DOUBLE,
        CD_sleepDeepSeconds    ENCRYPTED DOUBLE,
        CD_sleepREMSeconds     ENCRYPTED DOUBLE,
        CD_sleepSeconds        ENCRYPTED DOUBLE,
        CD_steps               ENCRYPTED DOUBLE,
        CD_vo2Max              ENCRYPTED DOUBLE,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_Goal (
        CD_createdAt             TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_eventDistanceMeters   DOUBLE QUERYABLE SORTABLE,
        CD_eventSportRaw         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_eventSportRaw_ckAsset ASSET,
        CD_moveReceipt           BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset   ASSET,
        CD_notes                 ENCRYPTED STRING,
        CD_notes_ckAsset         ASSET,
        CD_priorityRaw           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_priorityRaw_ckAsset   ASSET,
        CD_statusRaw             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_statusRaw_ckAsset     ASSET,
        CD_targetDate            TIMESTAMP QUERYABLE SORTABLE,
        CD_targetFinishSeconds   ENCRYPTED DOUBLE,
        CD_targetMetric          ENCRYPTED STRING,
        CD_targetMetric_ckAsset  ASSET,
        CD_title                 ENCRYPTED STRING,
        CD_title_ckAsset         ASSET,
        CD_typeRaw               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_typeRaw_ckAsset       ASSET,
        CD_uuid                  STRING QUERYABLE SEARCHABLE SORTABLE,
        "___createTime"          TIMESTAMP,
        "___createdBy"           REFERENCE,
        "___etag"                STRING,
        "___modTime"             TIMESTAMP,
        "___modifiedBy"          REFERENCE,
        "___recordID"            REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_PlanPhase (
        CD_endDate             TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_kindRaw             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_kindRaw_ckAsset     ASSET,
        CD_moveReceipt         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset ASSET,
        CD_plan                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_startDate           TIMESTAMP QUERYABLE SORTABLE,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_PlanSuggestion (
        CD_actionRaw                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_actionRaw_ckAsset          ASSET,
        CD_conversation               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_createdAt                  TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_moveReceipt                BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset        ASSET,
        CD_proposedChangeJSON         ENCRYPTED STRING,
        CD_proposedChangeJSON_ckAsset ASSET,
        CD_rationale                  ENCRYPTED STRING,
        CD_rationale_ckAsset          ASSET,
        CD_review                     STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_sourceID                   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_sourceID_ckAsset           ASSET,
        CD_statusRaw                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_statusRaw_ckAsset          ASSET,
        CD_targetSummary              ENCRYPTED STRING,
        CD_targetSummary_ckAsset      ASSET,
        CD_targetWorkout              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_uuid                       STRING QUERYABLE SEARCHABLE SORTABLE,
        "___createTime"               TIMESTAMP,
        "___createdBy"                REFERENCE,
        "___etag"                     STRING,
        "___modTime"                  TIMESTAMP,
        "___modifiedBy"               REFERENCE,
        "___recordID"                 REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_PlannedWorkout (
        CD_brickID                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_createdAt               TIMESTAMP QUERYABLE SORTABLE,
        CD_date                    TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_instructions            ENCRYPTED STRING,
        CD_instructions_ckAsset    ASSET,
        CD_isManualMatch           INT64 QUERYABLE SORTABLE,
        CD_matchedWorkout          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_moveReceipt             BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset     ASSET,
        CD_orderInDay              INT64 QUERYABLE SORTABLE,
        CD_plan                    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_runTargetsRaw           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_runTargetsRaw_ckAsset   ASSET,
        CD_sessionTypeRaw          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_sessionTypeRaw_ckAsset  ASSET,
        CD_sportRaw                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_sportRaw_ckAsset        ASSET,
        CD_statusRaw               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_statusRaw_ckAsset       ASSET,
        CD_structureJSON           ENCRYPTED STRING,
        CD_structureJSON_ckAsset   ASSET,
        CD_targetDistanceMeters    DOUBLE QUERYABLE SORTABLE,
        CD_targetDurationSeconds   DOUBLE QUERYABLE SORTABLE,
        CD_targetIntensity         ENCRYPTED STRING,
        CD_targetIntensity_ckAsset ASSET,
        CD_uuid                    STRING QUERYABLE SEARCHABLE SORTABLE,
        "___createTime"            TIMESTAMP,
        "___createdBy"             REFERENCE,
        "___etag"                  STRING,
        "___modTime"               TIMESTAMP,
        "___modifiedBy"            REFERENCE,
        "___recordID"              REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_ThresholdSnapshot (
        CD_createdAt                       TIMESTAMP QUERYABLE SORTABLE,
        CD_date                            TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName                      STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_ftpWatts                        ENCRYPTED DOUBLE,
        CD_maxHR                           ENCRYPTED DOUBLE,
        CD_moveReceipt                     BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset             ASSET,
        CD_restingHR                       ENCRYPTED DOUBLE,
        CD_thresholdRunPaceSecondsPerKm    ENCRYPTED DOUBLE,
        CD_thresholdSwimPaceSecondsPer100m ENCRYPTED DOUBLE,
        CD_uuid                            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_zoneUpperBounds                 ENCRYPTED BYTES,
        CD_zoneUpperBounds_ckAsset         ASSET,
        "___createTime"                    TIMESTAMP,
        "___createdBy"                     REFERENCE,
        "___etag"                          STRING,
        "___modTime"                       TIMESTAMP,
        "___modifiedBy"                    REFERENCE,
        "___recordID"                      REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_TrainingPlan (
        CD_coachSummary         ENCRYPTED STRING,
        CD_coachSummary_ckAsset ASSET,
        CD_createdAt            TIMESTAMP QUERYABLE SORTABLE,
        CD_endDate              TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_goal                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_isDraft              INT64 QUERYABLE SORTABLE,
        CD_moveReceipt          BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset  ASSET,
        CD_name                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_name_ckAsset         ASSET,
        CD_originRaw            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_originRaw_ckAsset    ASSET,
        CD_startDate            TIMESTAMP QUERYABLE SORTABLE,
        CD_uuid                 STRING QUERYABLE SEARCHABLE SORTABLE,
        "___createTime"         TIMESTAMP,
        "___createdBy"          REFERENCE,
        "___etag"               STRING,
        "___modTime"            TIMESTAMP,
        "___modifiedBy"         REFERENCE,
        "___recordID"           REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );
